{
    "ZVQUERY": {
        "summary": "Experimental multi-dimensional conditional scan over a ZVSET (full-scan reference).",
        "complexity": "O(N*F) where N is the cardinality and F the filter count.",
        "group": "sorted_set",
        "since": "9.2.0",
        "arity": -2,
        "function": "zvqueryCommand",
        "command_flags": [
            "READONLY"
        ],
        "acl_categories": [
