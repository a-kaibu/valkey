{
    "ZVREVRANGEBYLEX": {
        "summary": "Returns members in a ZVSET member-name range, ordered from high to low. Requires uniform vector scores.",
        "complexity": "O(log(N)+M)",
        "group": "sorted_set",
        "since": "9.2.0",
        "arity": -4,
        "function": "zvrevrangebylexCommand",
        "command_flags": [
            "READONLY"
        ],
