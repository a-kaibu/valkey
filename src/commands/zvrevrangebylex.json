            },
            {
                "name": "limit",
                "type": "block",
                "optional": true,
                "arguments": [
                    {
                        "name": "limit-token",
                        "token": "LIMIT",
                        "type": "pure-token"
                    },
                    {
                        "name": "offset",
                        "type": "integer"
                    },
                    {
                        "name": "count",
                        "type": "integer"
                    }
                ]
            }
        ]
    }
